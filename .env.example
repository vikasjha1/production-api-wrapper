APP_NAME="Production API Wrapper"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

# Clients allowed to call this gateway, as a JSON object: {"raw-key": "client-name"}
API_KEYS={}

# Optional, additive to API_KEYS above — a key absent from either of these
# is simply unrestricted (any provider) / never expires.
# Per-key provider restriction: {"raw-key": ["anthropic"]}
API_KEY_ALLOWED_PROVIDERS={}
# Per-key expiry (UTC, ISO 8601): {"raw-key": "2027-01-01T00:00:00Z"}
API_KEY_EXPIRES_AT={}

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/gateway

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

CACHE_TTL_SECONDS=300

RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5

CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30.0

IDEMPOTENCY_LOCK_TTL_SECONDS=60
IDEMPOTENCY_RESULT_TTL_SECONDS=86400

HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY_SECONDS=5.0
HTTP_TIMEOUT_SECONDS=30.0
